{
  "name": "gate-of-purchase",
  "description": "An editorial storefront concept for considered everyday clothing.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "format": "prettier --write src index.html package.json tsconfig.json tsconfig.app.json vite.config.mjs README.md"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  }
}
